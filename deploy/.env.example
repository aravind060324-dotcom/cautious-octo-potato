# Copy to deploy/.env for Compose (do not commit .env).

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Browser origins that may call the API directly (same-origin via Caddy is preferred).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
