LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
CATALOG_PATH=data/processed/restaurants.parquet
MAX_CANDIDATES=15
DEFAULT_LIMIT=5
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1000
# Comma-separated. Include https://*.vercel.app for Vercel preview/prod hosts.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
